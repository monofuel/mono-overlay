Source archives have no Git metadata. GitInfo.cmake already handles this case;
do not require an unused Git executable for an offline release build.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -39,6 +39,6 @@
 set(CMAKE_MODULE_PATH "${CMAKE_SOURCE_DIR}/cmake" "${CMAKE_MODULE_PATH}")
 
-find_package(Git REQUIRED)
+find_package(Git QUIET)
 include(GitInfo)
 
 message(STATUS "GIT_REVISION: ${GIT_REVISION}")
